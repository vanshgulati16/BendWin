<Window x:Class="BendWin.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BendWin" Width="480" Height="540"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        Background="#1C1C1E" Foreground="White"
        FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <!-- Dark slider style -->
        <Style x:Key="DarkSlider" TargetType="Slider">
            <Setter Property="Foreground" Value="#0A84FF"/>
            <Setter Property="Background" Value="#3A3A3C"/>
            <Setter Property="Height" Value="20"/>
        </Style>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8E8E93"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,12,0,4"/>
        </Style>
        <Style x:Key="ValueLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8E8E93"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#EBEBF5"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2C2C2E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ToggleButton">
            <Setter Property="Background" Value="#30D158"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock Text="BendWin" FontSize="20" FontWeight="SemiBold" Foreground="White"/>
        </StackPanel>

        <!-- Tabs -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">

            <!-- ── General ── -->
            <TabItem Header="General">
                <StackPanel Margin="4,12,4,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Enable BendWin" Foreground="White"/>
                            <TextBlock Text="Show the bend effect when closing your laptop lid"
                                       Style="{StaticResource SectionLabel}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" x:Name="ChkEnabled" VerticalAlignment="Center"
                                  Checked="OnEnabledChanged" Unchecked="OnEnabledChanged"/>
                    </Grid>

                    <Separator Background="#3A3A3C" Margin="0,12"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Start with Windows" Foreground="White"/>
                            <TextBlock Text="Launch BendWin automatically at login"
                                       Style="{StaticResource SectionLabel}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" x:Name="ChkStartup" VerticalAlignment="Center"
                                  Checked="OnStartupChanged" Unchecked="OnStartupChanged"/>
                    </Grid>

                    <Separator Background="#3A3A3C" Margin="0,12"/>

                    <TextBlock Foreground="#8E8E93" TextWrapping="Wrap" FontSize="12"
                        Text="BendWin requires Screen Capture permission to work. Windows will prompt you on first launch. Press Escape at any time to pause the effect."/>
                </StackPanel>
            </TabItem>

            <!-- ── Appearance ── -->
            <TabItem Header="Appearance">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="4,12,4,0">

                        <!-- Preset buttons -->
                        <TextBlock Text="STYLE" Style="{StaticResource SectionLabel}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="Silk"  x:Name="BtnSilk"  Margin="0,0,8,0" Click="OnPresetSilk"/>
                            <Button Content="Shade" x:Name="BtnShade" Margin="0,0,8,0" Click="OnPresetShade"/>
                            <Button Content="Frost" x:Name="BtnFrost" Click="OnPresetFrost"/>
                        </StackPanel>

                        <!-- Perspective -->
                        <TextBlock Text="PERSPECTIVE" Style="{StaticResource SectionLabel}"/>
                        <TextBlock Text="How far the upper edges draw inward"
                                   Foreground="#8E8E93" FontSize="11" Margin="0,0,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="SliderPerspective" Style="{StaticResource DarkSlider}"
                                    Minimum="0" Maximum="100" ValueChanged="OnPerspectiveChanged"/>
                            <TextBlock x:Name="LblPerspective" Grid.Column="1"
                                       Style="{StaticResource ValueLabel}" Text="35%"/>
                        </Grid>

                        <!-- Blur -->
                        <TextBlock Text="BLUR" Style="{StaticResource SectionLabel}"/>
                        <TextBlock Text="Softens the desktop toward the top"
                                   Foreground="#8E8E93" FontSize="11" Margin="0,0,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="SliderBlur" Style="{StaticResource DarkSlider}"
                                    Minimum="0" Maximum="100" ValueChanged="OnBlurChanged"/>
                            <TextBlock x:Name="LblBlur" Grid.Column="1"
                                       Style="{StaticResource ValueLabel}" Text="90%"/>
                        </Grid>

                        <!-- Shadow -->
                        <TextBlock Text="SHADOW" Style="{StaticResource SectionLabel}"/>
                        <TextBlock Text="Adds depth along the folded edges"
                                   Foreground="#8E8E93" FontSize="11" Margin="0,0,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="SliderShadow" Style="{StaticResource DarkSlider}"
                                    Minimum="0" Maximum="100" ValueChanged="OnShadowChanged"/>
                            <TextBlock x:Name="LblShadow" Grid.Column="1"
                                       Style="{StaticResource ValueLabel}" Text="35%"/>
                        </Grid>

                        <Button Content="Reset to defaults" Margin="0,16,0,0" HorizontalAlignment="Left"
                                Click="OnResetAppearance"/>

                        <Separator Background="#3A3A3C" Margin="0,16"/>

                        <!-- Preview -->
                        <TextBlock Text="PREVIEW" Style="{StaticResource SectionLabel}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="SliderPreview" Style="{StaticResource DarkSlider}"
                                    Minimum="12" Maximum="135" Value="135"
                                    ValueChanged="OnPreviewAngleChanged"/>
                            <TextBlock x:Name="LblPreviewAngle" Grid.Column="1"
                                       Style="{StaticResource ValueLabel}" Text="135°"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ── Lid Behaviour ── -->
            <TabItem Header="Lid">
                <StackPanel Margin="4,12,4,0">

                    <!-- Sensor status -->
                    <TextBlock Text="SENSOR STATUS" Style="{StaticResource SectionLabel}"/>
                    <TextBlock x:Name="LblSensorStatus" Foreground="#30D158" FontSize="12"
                               Text="Detecting sensor…"/>

                    <Separator Background="#3A3A3C" Margin="0,12"/>

                    <!-- Follow lid toggle -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Follow physical lid" Foreground="White"/>
                            <TextBlock Text="Use the sensor to track lid movement in real time"
                                       Style="{StaticResource SectionLabel}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" x:Name="ChkFollowLid" VerticalAlignment="Center"
                                  Checked="OnFollowLidChanged" Unchecked="OnFollowLidChanged"/>
                    </Grid>

                    <!-- Manual angle (visible when FollowLid = false) -->
                    <StackPanel x:Name="PanelManual" Visibility="Collapsed">
                        <TextBlock Text="DESKTOP ANGLE" Style="{StaticResource SectionLabel}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="SliderManual" Style="{StaticResource DarkSlider}"
                                    Minimum="12" Maximum="135" ValueChanged="OnManualAngleChanged"/>
                            <TextBlock x:Name="LblManualAngle" Grid.Column="1"
                                       Style="{StaticResource ValueLabel}" Text="90°"/>
                        </Grid>
                    </StackPanel>

                    <!-- Clear angle -->
                    <TextBlock Text="CLEAR ANGLE" Style="{StaticResource SectionLabel}"/>
                    <TextBlock Text="The desktop returns to normal above this angle"
                               Foreground="#8E8E93" FontSize="11" Margin="0,0,0,4"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="SliderClear" Style="{StaticResource DarkSlider}"
                                Minimum="80" Maximum="135" ValueChanged="OnClearAngleChanged"/>
                        <TextBlock x:Name="LblClearAngle" Grid.Column="1"
                                   Style="{StaticResource ValueLabel}" Text="110°"/>
                    </Grid>

                    <Button Content="Use current angle" Margin="0,8,0,0" HorizontalAlignment="Left"
                            Click="OnUseCurrentAngle"/>

                    <Separator Background="#3A3A3C" Margin="0,12"/>

                    <!-- Animation duration (for power-event fallback) -->
                    <TextBlock Text="ANIMATION DURATION (power-event mode)"
                               Style="{StaticResource SectionLabel}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="SliderAnimDuration" Style="{StaticResource DarkSlider}"
                                Minimum="0.2" Maximum="2" SmallChange="0.1"
                                ValueChanged="OnAnimDurationChanged"/>
                        <TextBlock x:Name="LblAnimDuration" Grid.Column="1"
                                   Style="{StaticResource ValueLabel}" Text="0.6s"/>
                    </Grid>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Play sound when unfolding" Foreground="White"
                                   VerticalAlignment="Center"/>
                        <CheckBox Grid.Column="1" x:Name="ChkSound" VerticalAlignment="Center"
                                  Checked="OnSoundChanged" Unchecked="OnSoundChanged"/>
                    </Grid>
                </StackPanel>
            </TabItem>

            <!-- ── About ── -->
            <TabItem Header="About">
                <StackPanel Margin="4,20,4,0">
                    <TextBlock Text="BendWin" FontSize="22" FontWeight="Bold" Foreground="White"/>
                    <TextBlock x:Name="LblVersion" Foreground="#8E8E93" FontSize="12" Margin="0,4,0,16"/>
                    <TextBlock TextWrapping="Wrap" Foreground="#EBEBF5"
                        Text="BendWin brings the BendMac-style lid-fold animation to Windows. GPU-accelerated with Direct3D 11 and Windows Graphics Capture."/>
                    <Separator Background="#3A3A3C" Margin="0,16"/>
                    <Button Content="Check for updates" HorizontalAlignment="Left" Margin="0,0,0,8"
                            Click="OnCheckUpdates"/>
                    <Button Content="View on GitHub" HorizontalAlignment="Left"
                            Click="OnOpenGitHub"/>
                    <Separator Background="#3A3A3C" Margin="0,16"/>
                    <TextBlock Text="MIT License · Open source" Foreground="#8E8E93" FontSize="11"/>
                </StackPanel>
            </TabItem>

        </TabControl>
    </Grid>
</Window>
